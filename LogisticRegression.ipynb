    "import pandas as pd\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "d={\n",
    "    'marks':[35, 45, 55, 65, 75],\n",
    "    'result':[0, 0, 0, 1, 1]\n",
    "}\n",
    "df=pd.DataFrame(d)\n",
    "model=LogisticRegression()\n",
    "model.fit(df[['marks']],df['result'])\n",
    "print(model.predict([[50]]))\n"
   ]
  }
