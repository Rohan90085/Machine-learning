   "source": [
    "import cv2\n",
    "\n",
    "img = cv2.imread(\"Photos/Ganesha.png\", 0)\n",
    "\n",
    "clahe = cv2.createCLAHE(\n",
    "    clipLimit=2.0,\n",
    "    tileGridSize=(8,8)\n",
    ")\n",
    "\n",
    "result = clahe.apply(img)\n",
    "\n",
    "cv2.imshow(\"CLAHE\", result)\n",
    "\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()"
   ]
  }
 ],
